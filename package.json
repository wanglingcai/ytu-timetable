{
  "name": "ytu-timetable",
  "version": "0.9.4",
  "private": true,
  "description": "下节啥课：安卓离线课表、文件导入与周次切换",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "fixtures": "node scripts/make-fixtures.cjs",
    "test:ui": "playwright test",
    "test:visual": "playwright test tests/ui/visual-regression.spec.cjs",
    "format": "prettier --write \"app/src/main/assets/**/*.{html,css,js}\"",
    "format:check": "prettier --check \"app/src/main/assets/**/*.{html,css,js}\""
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "prettier": "3.6.2"
  }
}
